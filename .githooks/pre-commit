#!/bin/sh
echo "Running unit tests before commit..."

dotnet test SimpleRestApi.sln --nologo --verbosity quiet

if [ $? -ne 0 ]; then
  echo ""
  echo "Commit aborted: one or more unit tests failed."
  echo "Fix the failing tests and try again."
  exit 1
fi

echo "All tests passed. Proceeding with commit."
exit 0
